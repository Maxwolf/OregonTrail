<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Multi-size .ico built from the ox-team-and-wagon travel sprite (Assets: art/sprites/travelox/01.png). -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>C:\OregonTrail\bin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>C:\OregonTrail\bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolfCurses" Version="2026.11.17.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- Pin the native SQLite bundle forward past the vulnerable transitive 2.1.11 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- The shared presentation layer (scene forms, art decode, chiptune audio) plus the embedded original MECC
         assets it draws from. Only forms gated behind GameSimulationApp.PresentationEnabled ever touch it, so the
         bot and tests carry it as a dormant dependency. -->
    <ProjectReference Include="..\OregonTrailDotNet.Presentation\OregonTrailDotNet.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OregonTrailDotNet.Tests" />
    <InternalsVisibleTo Include="OregonTrailDotNet.Bot" />
    <InternalsVisibleTo Include="OregonTrailDotNet.Bot.Tests" />
  </ItemGroup>

</Project>
